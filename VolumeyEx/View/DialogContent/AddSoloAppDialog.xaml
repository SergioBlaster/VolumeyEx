<ui:ContentDialog x:Class="VolumeyEx.View.DialogContent.AddSoloAppDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:lc="clr-namespace:VolumeyEx.Localization"
                  Title="{lc:Localization AppHotkeys_AddTitle}"
                  PrimaryButtonText="{lc:Localization AppHotkeys_Add}"
                  CloseButtonText="{lc:Localization AppHotkeys_Cancel}"
                  DefaultButton="Primary"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- App hotkeys page, the solo round's "Add app": one of the open apps that isn't in the round yet.
         Add stays disabled until an app is picked (see the code-behind) -->
    <ui:ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VolumeyEx;component/View/Styles/SettingsPage.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:ContentDialog.Resources>
    <Grid Width="400">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="0 0 16 0">
            <TextBlock Text="{lc:Localization AppHotkeys_App}" />
            <TextBlock Text="{lc:Localization AppHotkeys_SoloAppHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </StackPanel>
        <ComboBox Grid.Column="1"
                  Width="220"
                  ItemsSource="{Binding AddableSoloApps}"
                  SelectedItem="{Binding SelectedSoloApp}"
                  IsSynchronizedWithCurrentItem="False"
                  AutomationProperties.Name="{lc:Localization AppHotkeys_App}"
                  AutomationProperties.AutomationId="AddSoloAppBox">
            <!-- screen readers read the app's name, not the model's type -->
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding IconSource}" Width="16" Height="16" Margin="0 0 8 0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0 8 0 0" Text="{lc:Localization AppHotkeys_SoloNoOpenApps}" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AddableSoloApps.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</ui:ContentDialog>
