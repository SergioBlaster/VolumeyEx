<Page x:Class="VolumeyEx.View.SettingsPage.AppHotkeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lc="clr-namespace:VolumeyEx.Localization"
      xmlns:converters="clr-namespace:VolumeyEx.View.Converters"
      xmlns:controls="clr-namespace:VolumeyEx.Controls"
      xmlns:viewControls="clr-namespace:VolumeyEx.View.Controls"
      Title="{lc:Localization Nav_AppHotkeys}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      controls:HotKeyBox.HotkeyService="{Binding Hotkeys}">
    <!-- the Foreground: see GeneralPage -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VolumeyEx;component/View/Styles/SettingsPage.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:HotkeysRegisteredToEnabledConverter x:Key="NotRegisteredToEnabled" />
            <converters:LocalizedFormatConverter x:Key="LocalizedFormat" />
            <!-- a row's label lines up with its hotkey box, also when an error shows under the box -->
            <Style x:Key="HotkeyRowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0 6 0 0" />
            </Style>
            <!-- the error of one hotkey, under its box -->
            <Style x:Key="HotkeyError" TargetType="TextBlock" BasedOn="{StaticResource SettingError}">
                <Setter Property="MaxWidth" Value="180" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0 4 0 0" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <!-- the app list is an expander per app; apps are added in a dialog and their hotkeys can be changed in place -->
    <!-- no ScrollViewer here: see GeneralPage -->
        <StackPanel Margin="16 4 40 32">
            <TextBlock Text="{lc:Localization Nav_AppHotkeys}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{lc:Localization AppHotkeys_Description}" Style="{StaticResource PageDescription}" />
            <!-- what the hotkey mode means for this page's hotkeys, at the top -->
            <viewControls:HotkeyModeNote KeysBlocked="{Binding HotkeyMode.BlockHotkeysInSystem}" />

            <TextBlock Text="{lc:Localization AppHotkeys_Foreground}" Style="{StaticResource SectionHeader}" />
            <!-- the hotkeys can be edited while it's off; turning it on registers them -->
            <ui:CardExpander Icon="{ui:SymbolIcon WindowApps24}" IsExpanded="True" Margin="0 0 0 4"
                             DataContext="{Binding Foreground}"
                             AutomationProperties.Name="{lc:Localization AppHotkeys_ForegroundTitle}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{lc:Localization AppHotkeys_ForegroundTitle}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="16 0"
                                         IsChecked="{Binding HotkeysRegistered}"
                                         AutomationProperties.Name="{lc:Localization AppHotkeys_ForegroundTitle}"
                                         AutomationProperties.AutomationId="ForegroundToggle" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="40 0 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{lc:Localization AppHotkeys_VolumeUp}" Style="{StaticResource HotkeyRowLabel}" />
                    <StackPanel Grid.Column="1" Margin="0 0 0 8">
                        <controls:HotKeyBox HotKey="{Binding VolumeUpHotkey}"
                                            IsEnabled="{Binding HotkeysRegistered, Converter={StaticResource NotRegisteredToEnabled}}"
                                            AutomationProperties.Name="{lc:Localization AppHotkeys_VolumeUp}"
                                            AutomationProperties.AutomationId="ForegroundUpBox" />
                        <TextBlock Text="{Binding Errors.VolumeUp}" Style="{StaticResource HotkeyError}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{lc:Localization AppHotkeys_VolumeDown}" Style="{StaticResource HotkeyRowLabel}" />
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <controls:HotKeyBox HotKey="{Binding VolumeDownHotkey}"
                                            IsEnabled="{Binding HotkeysRegistered, Converter={StaticResource NotRegisteredToEnabled}}"
                                            AutomationProperties.Name="{lc:Localization AppHotkeys_VolumeDown}"
                                            AutomationProperties.AutomationId="ForegroundDownBox" />
                        <TextBlock Text="{Binding Errors.VolumeDown}" Style="{StaticResource HotkeyError}" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander>

            <!-- mute all apps and the solo round: one hotkey each, edited while it's off; turning it on registers it -->
            <TextBlock Text="{lc:Localization AppHotkeys_MuteSection}" Style="{StaticResource SectionHeader}" />
            <StackPanel DataContext="{Binding AppMute}">
                <ui:CardExpander Icon="{ui:SymbolIcon SpeakerMute24}" IsExpanded="True" Margin="0 0 0 4"
                                 AutomationProperties.Name="{lc:Localization AppHotkeys_MuteAll}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{lc:Localization AppHotkeys_MuteAll}" />
                                <TextBlock Text="{Binding MuteAllError}" Style="{StaticResource SettingError}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             Margin="16 0"
                                             IsChecked="{Binding MuteAllRegistered}"
                                             AutomationProperties.Name="{lc:Localization AppHotkeys_MuteAll}"
                                             AutomationProperties.AutomationId="MuteAllToggle" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <Grid Margin="40 0 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{lc:Localization AppHotkeys_MuteAllDescription}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0 0 16 0" />
                        <controls:HotKeyBox Grid.Column="1"
                                            HotKey="{Binding MuteAllKey}"
                                            IsEnabled="{Binding MuteAllRegistered, Converter={StaticResource NotRegisteredToEnabled}}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{lc:Localization AppHotkeys_MuteAll}"
                                            AutomationProperties.AutomationId="MuteAllBox" />
                    </Grid>
                </ui:CardExpander>
                <ui:CardExpander Icon="{ui:SymbolIcon ArrowRepeatAll24}" IsExpanded="True" Margin="0"
                                 AutomationProperties.Name="{lc:Localization AppHotkeys_Solo}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{lc:Localization AppHotkeys_Solo}" />
                                <TextBlock Text="{Binding SoloError}" Style="{StaticResource SettingError}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             Margin="16 0"
                                             IsChecked="{Binding SoloRegistered}"
                                             AutomationProperties.Name="{lc:Localization AppHotkeys_Solo}"
                                             AutomationProperties.AutomationId="SoloToggle" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <StackPanel Margin="40 0 0 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lc:Localization AppHotkeys_SoloDescription}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0 0 16 0" />
                            <controls:HotKeyBox Grid.Column="1"
                                                HotKey="{Binding SoloKey}"
                                                IsEnabled="{Binding SoloRegistered, Converter={StaticResource NotRegisteredToEnabled}}"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{lc:Localization AppHotkeys_Solo}"
                                                AutomationProperties.AutomationId="SoloBox" />
                        </Grid>
                        <!-- the round's apps, in its order: added from the open apps, moved up and down, removed -->
                        <Grid Margin="0 16 0 8">
                            <TextBlock Text="{lc:Localization AppHotkeys_SoloApps}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button HorizontalAlignment="Right"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Content="{lc:Localization AppHotkeys_AddApp}"
                                       Click="OnAddSoloAppClick"
                                       AutomationProperties.AutomationId="AddSoloAppButton" />
                        </Grid>
                        <TextBlock Text="{lc:Localization AppHotkeys_SoloNoApps}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SoloApps.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding SoloApps}" Focusable="False" AutomationProperties.AutomationId="SoloAppList">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0 2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding IconSource}" Width="20" Height="20" Margin="0 0 12 0" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <ui:Button Grid.Column="2" Appearance="Transparent" Padding="8 6" Margin="4 0 0 0"
                                                   Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding MoveUpCommand}"
                                                   ToolTip="{lc:Localization AppHotkeys_MoveUp}">
                                            <AutomationProperties.Name>
                                                <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="AppHotkeys_MoveUpApp">
                                                    <Binding Path="Name" />
                                                    <Binding Source="{x:Static lc:TranslationSource.Instance}" Path="CurrentCulture" />
                                                </MultiBinding>
                                            </AutomationProperties.Name>
                                        </ui:Button>
                                        <ui:Button Grid.Column="3" Appearance="Transparent" Padding="8 6" Margin="4 0 0 0"
                                                   Icon="{ui:SymbolIcon ArrowDown24}" Command="{Binding MoveDownCommand}"
                                                   ToolTip="{lc:Localization AppHotkeys_MoveDown}">
                                            <AutomationProperties.Name>
                                                <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="AppHotkeys_MoveDownApp">
                                                    <Binding Path="Name" />
                                                    <Binding Source="{x:Static lc:TranslationSource.Instance}" Path="CurrentCulture" />
                                                </MultiBinding>
                                            </AutomationProperties.Name>
                                        </ui:Button>
                                        <ui:Button Grid.Column="4" Appearance="Transparent" Padding="8 6" Margin="4 0 0 0"
                                                   Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCommand}"
                                                   ToolTip="{lc:Localization AppHotkeys_Remove}">
                                            <AutomationProperties.Name>
                                                <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="AppHotkeys_RemoveApp">
                                                    <Binding Path="Name" />
                                                    <Binding Source="{x:Static lc:TranslationSource.Instance}" Path="CurrentCulture" />
                                                </MultiBinding>
                                            </AutomationProperties.Name>
                                        </ui:Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>

            <Grid Margin="0 20 0 8" DataContext="{Binding AppHotkeys}">
                <TextBlock Text="{lc:Localization AppHotkeys_Apps}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ui:Button HorizontalAlignment="Right"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Add24}"
                           Content="{lc:Localization AppHotkeys_AddApp}"
                           Click="OnAddAppClick"
                           AutomationProperties.AutomationId="AddAppButton" />
            </Grid>

            <StackPanel DataContext="{Binding AppHotkeys}">
                <TextBlock Text="{lc:Localization AppHotkeys_NoApps}" Margin="0 0 0 4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Apps}" Focusable="False" AutomationProperties.AutomationId="AppList">
                    <!-- a row's name for screen readers; without it they read the item's type name -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding ProcessName}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardExpander Margin="0 0 0 4" AutomationProperties.Name="{Binding ProcessName}">
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- the app's icon while it runs, a generic one otherwise (only the process name is saved) -->
                                        <Grid Width="24" Height="24" Margin="0 0 16 0" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" />
                                            <ui:SymbolIcon Symbol="AppGeneric24" FontSize="20">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="16 0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VolumeUp}" Style="{StaticResource Caption}" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding VolumeDown}" Style="{StaticResource Caption}" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>
                                </ui:CardExpander.Header>
                                <Grid Margin="40 0 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{lc:Localization AppHotkeys_VolumeUp}" Style="{StaticResource HotkeyRowLabel}" />
                                    <StackPanel Grid.Column="1" Margin="0 0 0 8">
                                        <controls:HotKeyBox HotKey="{Binding VolumeUp}">
                                            <AutomationProperties.Name>
                                                <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="AppHotkeys_AppVolumeUp">
                                                    <Binding Path="ProcessName" />
                                                    <Binding Source="{x:Static lc:TranslationSource.Instance}" Path="CurrentCulture" />
                                                </MultiBinding>
                                            </AutomationProperties.Name>
                                        </controls:HotKeyBox>
                                        <TextBlock Text="{Binding Errors.VolumeUp}" Style="{StaticResource HotkeyError}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{lc:Localization AppHotkeys_VolumeDown}" Style="{StaticResource HotkeyRowLabel}" />
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <controls:HotKeyBox HotKey="{Binding VolumeDown}">
                                            <AutomationProperties.Name>
                                                <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="AppHotkeys_AppVolumeDown">
                                                    <Binding Path="ProcessName" />
                                                    <Binding Source="{x:Static lc:TranslationSource.Instance}" Path="CurrentCulture" />
                                                </MultiBinding>
                                            </AutomationProperties.Name>
                                        </controls:HotKeyBox>
                                        <TextBlock Text="{Binding Errors.VolumeDown}" Style="{StaticResource HotkeyError}" />
                                    </StackPanel>
                                    <ui:Button Grid.Row="2"
                                               Grid.Column="1"
                                               Margin="0 12 0 0"
                                               HorizontalAlignment="Right"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               Content="{lc:Localization AppHotkeys_Remove}"
                                               Command="{Binding RemoveCommand}">
                                        <AutomationProperties.Name>
                                            <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="AppHotkeys_RemoveApp">
                                                <Binding Path="ProcessName" />
                                                <Binding Source="{x:Static lc:TranslationSource.Instance}" Path="CurrentCulture" />
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </ui:Button>
                                </Grid>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
</Page>
